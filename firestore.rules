rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Seuls ces deux comptes Google peuvent lire et écrire (mêmes adresses que dans public/js/config.js)
    function autorise() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['ton.adresse@gmail.com', 'adresse.de.ta.femme@gmail.com'];
    }
    match /{document=**} {
      allow read, write: if autorise();
    }
  }
}
